# Template for `.dev.vars` — local secrets consumed by the Wrangler/Vite dev
# runtime (Cloudflare Workers env vars for local dev, NOT `.env`/Vite client
# vars). `.dev.vars*` is gitignored except this example file.
#
# Copy this file to `.dev.vars` and fill in real values before running
# `bun run dev`:
#
#   cp .dev.vars.example .dev.vars

BETTER_AUTH_SECRET=change-me-openssl-rand-hex-16

# Anthropic API key for the walkie-talkie board agent (feature: llm-board-agent).
# The board's LLM path uses `claude-sonnet-5` with schema-enforced structured
# output. Without a key the agent's unit tests still pass (they run against a
# stubbed client), but the live generation path cannot run.
#
# EITHER FILE WORKS for local dev: this wrangler version also loads `.env`, and
# `bun run cf-typegen` proves which vars actually reach the Worker — the key shows
# up in BOTH `Cloudflare.Env` and `Cloudflare.PreviewEnv` in
# `worker-configuration.d.ts`. Read it through the `CloudflareEnv` tag, never
# `process.env` (non-negotiable #5).
#
# DEPLOYS ARE SEPARATE: `.env` / `.dev.vars` are local-only and gitignored, so
# production and preview need the secret pushed explicitly:
#     wrangler secret put ANTHROPIC_API_KEY
#     wrangler secret put ANTHROPIC_API_KEY --env preview
#
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional — OTLP trace export (see .brain/codebase/observability.md).
# Unset = tracing export off (logs still carry traceId). Local viewer:
# `otel-tui` or Jaeger listen on http://localhost:4318.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20<token>
# OTEL_SERVICE_NAME=flappyboard
