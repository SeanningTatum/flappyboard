// Generated by scripts/first-time-setup.ts — real IDs are filled in by setup; teardown restores dummy values.
{
  "name": "flappyboard",
  "main": "workers/app.ts",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "build/client",
    "binding": "ASSETS"
  },
  "placement": {
    "mode": "smart"
  },
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "flappyboard-db",
      "database_id": "d84888c9-bcb1-490f-9f17-6bd155954841",
      "migrations_dir": "./drizzle"
    }
  ],
  "workflows": [
    {
      "binding": "EXAMPLE_WORKFLOW",
      "name": "flappyboard-example-workflow",
      "class_name": "ExampleWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD",
        "class_name": "BoardRoom"
      }
    ]
  },
  // SQLite-backed DOs (`new_sqlite_classes`) are available on the Workers free
  // plan; `new_classes` (KV-backed) is not. Migration tags are shared across
  // environments, so this list is identical in `env.preview`.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BoardRoom"
      ]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "workers_dev": true,
  "preview_urls": true,
  "env": {
    "preview": {
      "workers_dev": true,
      "preview_urls": true,
      "d1_databases": [
        {
          "binding": "DATABASE",
          "database_name": "flappyboard-db-preview",
          "database_id": "d27f409a-dc44-4b7a-ba2d-3d1097ba69e6",
          "migrations_dir": "./drizzle"
        }
      ],
      "workflows": [
        {
          "binding": "EXAMPLE_WORKFLOW",
          "name": "flappyboard-example-workflow-preview",
          "class_name": "ExampleWorkflow"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "BOARD",
            "class_name": "BoardRoom"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "BoardRoom"
          ]
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "observability": {
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true,
          "persist": true
        }
      }
    }
  }
}
